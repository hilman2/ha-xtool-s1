# Normalise everything to LF in the repo, regardless of the OS
# the working copy lives on. PNGs (the brand assets) and any
# future binary blobs are kept untouched.

* text=auto eol=lf

*.py text eol=lf
*.sh text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.toml text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
